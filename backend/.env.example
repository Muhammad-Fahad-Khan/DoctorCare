# MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/docucare"

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Used to AES-256-GCM encrypt the Groq API key stored in SystemSettings.
# The key entered by the Admin in the CMS panel is encrypted with this before
# being persisted — this secret itself never touches the database.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-char-hex-string"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
